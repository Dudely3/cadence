# Copy to .env and fill in. The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is identity-linked (issued to a person, not a project).
# Without it every request 400s with "anthropic-workspace-id is required".
# Find it in the Anthropic Console under Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=
